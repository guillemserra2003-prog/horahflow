{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://jmqikuquouqvcmkimrdk.supabase.co/:path*"
    },
    {
      "source": "/vendor/supabase.js",
      "destination": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.4/dist/umd/supabase.min.js"
    },
    {
      "source": "/vendor/pdfjs/:file(pdf\\.min\\.mjs|pdf\\.worker\\.min\\.mjs)",
      "destination": "https://cdn.jsdelivr.net/npm/pdfjs-dist@6.2.108/legacy/build/:file"
    }
  ],
  "redirects": [
    {
      "source": "/terminos",
      "destination": "/condiciones/",
      "permanent": true
    },
    {
      "source": "/blog/:slug((?!.*\\.).*[^/])",
      "destination": "/blog/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/blog/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
